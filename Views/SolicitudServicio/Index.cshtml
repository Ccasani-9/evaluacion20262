@model IEnumerable<TecnoGasHogar.Models.SolicitudServicio>

@{
    ViewData["Title"] = "Solicitudes de Servicio";

    string BadgeClass(string tipo) => tipo switch
    {
        "Instalación" => "bg-primary",
        "Mantenimiento" => "bg-info text-dark",
        "Revisión" => "bg-secondary",
        "Fuga" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">📋 @ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nueva Solicitud</a>
</div>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success" role="alert">
        ✅ @TempData["MensajeExito"]
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="tg-card p-3 text-center h-100">
            <div class="fs-3 fw-bold text-primary">@ViewBag.TotalSolicitudes</div>
            <div class="text-muted small">Total de solicitudes</div>
        </div>
    </div>
    @foreach (var (tipo, cantidad) in (List<(string Tipo, int Cantidad)>)ViewBag.ConteoPorTipo)
    {
        <div class="col-6 col-md-3">
            <div class="tg-card p-3 text-center h-100">
                <div class="fs-3 fw-bold">@cantidad</div>
                <div class="text-muted small">@tipo</div>
            </div>
        </div>
    }
</div>

<div class="tg-card p-3 p-md-4">
    @if (!Model.Any())
    {
        <p class="text-muted text-center my-4 mb-0">Aún no hay solicitudes registradas.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle tg-table mb-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(m => m.Cliente)</th>
                        <th>@Html.DisplayNameFor(m => m.Telefono)</th>
                        <th>@Html.DisplayNameFor(m => m.Distrito)</th>
                        <th>@Html.DisplayNameFor(m => m.TipoServicio)</th>
                        <th>@Html.DisplayNameFor(m => m.Descripcion)</th>
                        <th>@Html.DisplayNameFor(m => m.FechaRegistro)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var solicitud in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@solicitud.Cliente</td>
                            <td>@solicitud.Telefono</td>
                            <td>@solicitud.Distrito</td>
                            <td><span class="badge @BadgeClass(solicitud.TipoServicio)">@solicitud.TipoServicio</span></td>
                            <td>@solicitud.Descripcion</td>
                            <td class="text-muted">@solicitud.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
